CLIENT_ID=
CLIENT_SECRET=
USER_ID=
REFRESH_TOKEN=
COUNTRY_CODE=

# Optional unrestricted credential for search, albums, artists, playlists, etc.
# Prefer a refreshable credential (an account without an active subscription is fine).
CATALOG_CLIENT_ID=
CATALOG_CLIENT_SECRET=
CATALOG_REFRESH_TOKEN=
CATALOG_USER_ID=
# Alternatively provide a static bearer token (it cannot be refreshed automatically).
# CATALOG_TOKEN=

USE_PROXIES=False
ROTATE_PROXIES_ON_REFRESH=False
PROXIES_FILE=proxies.txt
MAX_RETRIES=2
# WARNING: If set to True, the app will expose the host IP if all proxies fail or proxies.txt is misconfigured!
FALLBACK_TO_DIRECT_CONNECTION=False
# Override the User-Agent sent to Tidal
# USER_AGENT=okhttp/5.3.2
# Enable verbose logging of every upstream request (status, headers, body)
# DEV_MODE=True

# Playback queue hardening. A playback account slot held longer than
# PLAYBACK_LEASE_TIMEOUT seconds is reclaimed by the watchdog (and the request
# that held it is failed), so one wedged request cannot leave the instance
# answering 202 to every playback request.
# PLAYBACK_LEASE_TIMEOUT=90
# A queued playback request that waits longer than PLAYBACK_JOB_TIMEOUT
# seconds fails instead of hanging until the client gives up.
# PLAYBACK_JOB_TIMEOUT=180
# Refuse new queue entries past this many pending requests.
# PLAYBACK_MAX_PENDING_JOBS=200
